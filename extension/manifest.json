{
  "manifest_version": 3,
  "name": "LinkedIn Autofeed",
  "version": "1.0.1",
  "description": "A chronological feed for the LinkedIn profiles you choose.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "scripting", "storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open LinkedIn Autofeed",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "options_page": "feed.html"
}
